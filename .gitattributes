# Auto detect text files and perform LF normalization
* text=auto

# Code files — always use LF (best for cross-platform)
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf

# Windows-specific files — use CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files — never touch these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary

# Minified files — don't warn
*.min.js  -text
*.min.css -text